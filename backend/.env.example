# ==============================================================================
# Backend Environment Configuration Template
# ==============================================================================
# Duplicate this file as '.env' in this directory and populate with your credentials.
# Do NOT commit your actual '.env' file with production keys to version control.

# Supabase PostgreSQL & pgvector Credentials
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key_here

# Groq Cloud API Key
# Used for ultra-fast LLM inference (Qwen 3.8 27B)
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API Key
# Used for text-embedding-004 / gemini-embedding-001 (768 dimensions)
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
